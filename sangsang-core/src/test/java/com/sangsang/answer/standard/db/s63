SELECT CAST(AES_DECRYPT(FROM_BASE64(tr.role_name), '测试秘钥') AS CHAR) AS role_name, tr.role_desc, tr.id, tr.create_time, tr.update_time, tu.user_name, tu.login_name, tu.login_pwd, CAST(AES_DECRYPT(FROM_BASE64(tu.phone), '7uq?q8g3@q') AS CHAR) AS phone, tu.role_id, tu.id, tu.create_time, tu.update_time FROM tb_user tu JOIN tb_role tr ON tr.role_name IN (SELECT TO_BASE64(AES_ENCRYPT(CAST(AES_DECRYPT(FROM_BASE64(phone), '7uq?q8g3@q') AS CHAR), '测试秘钥')) AS phone FROM tb_user WHERE phone = TO_BASE64(AES_ENCRYPT(?, '7uq?q8g3@q')))
