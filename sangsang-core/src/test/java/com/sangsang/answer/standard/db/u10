UPDATE tb_user tu SET tu.user_name = su.user_name FROM tb_user su JOIN tb_role tr ON tr.role_name IN (SELECT TO_BASE64(AES_ENCRYPT(CAST(AES_DECRYPT(FROM_BASE64(phone), '7uq?q8g3@q') AS CHAR), '测试秘钥')) AS phone FROM tb_user WHERE phone = TO_BASE64(AES_ENCRYPT(?, '7uq?q8g3@q'))) WHERE (tu.id = su.id)
