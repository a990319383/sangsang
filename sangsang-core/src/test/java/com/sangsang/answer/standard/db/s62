SELECT CAST(AES_DECRYPT(FROM_BASE64(tr.role_name), '测试秘钥') AS CHAR) AS role_name, tr.role_desc, tr.id, tr.create_time, tr.update_time, tu.* FROM ((SELECT tb_user.user_name, tb_user.login_name, tb_user.login_pwd, CAST(AES_DECRYPT(FROM_BASE64(tb_user.phone), '7uq?q8g3@q') AS CHAR) AS phone, tb_user.role_id, tb_user.id, tb_user.create_time, tb_user.update_time FROM tb_user WHERE phone = TO_BASE64(AES_ENCRYPT(?, '7uq?q8g3@q'))) tu JOIN tb_role tr ON tu.phone = CAST(AES_DECRYPT(FROM_BASE64(tr.role_name), '测试秘钥') AS CHAR))
